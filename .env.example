# ---------------------------------------------------------------------------
# HomeFlow example configuration — PLACEHOLDERS ONLY.
# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Addresses below are RFC 5737 documentation ranges, not real hosts.
# ---------------------------------------------------------------------------

HOMEFLOW_ENV=development
HOMEFLOW_DEMO_MODE=true

# Bind to loopback locally. In production bind to the private/VPN interface only.
HOMEFLOW_API_HOST=127.0.0.1
HOMEFLOW_API_PORT=8000
HOMEFLOW_LOG_LEVEL=INFO

# Directory of the installable web client. Leave unset when running from a
# source checkout: the gateway then finds apps/web on its own.
# HOMEFLOW_WEB_CLIENT_DIR=/app/web

# Stable, non-reversible mapping of provider device ids to HomeFlow UUIDs.
# Required outside demo mode. Generate with: python scripts/generate_secret.py
HOMEFLOW_ID_SALT=replace-me-with-32-random-bytes-hex

# Local development client credential (development/test only).
# Generate with: python scripts/generate_client_token.py
# Startup fails if this is set while HOMEFLOW_ENV=production.
HOMEFLOW_DEV_CLIENT_TOKEN=replace-me

# Phase 2+ — not used by the current code yet.
HOMEFLOW_DATABASE_URL=postgresql+psycopg://homeflow:example@db:5432/homeflow

HOME_ASSISTANT_BASE_URL=http://home-assistant.example.internal:8123
HOME_ASSISTANT_TOKEN=replace-me

# Bestway AirJet. Both gates default to refusing; see
# docs/integrations/bestway.md before changing them.
HOMEFLOW_BESTWAY_ENABLED=false
HOMEFLOW_BESTWAY_HOST=192.0.2.10
HOMEFLOW_BESTWAY_PORT=12416
HOMEFLOW_BESTWAY_POLL_SECONDS=15
# Set only after every decoded value was compared with the physical panel.
HOMEFLOW_BESTWAY_TRUST_PROFILE=false
# Your verified layout. Keep this file out of the repository.
# HOMEFLOW_BESTWAY_PROFILE_PATH=/etc/homeflow/airjet.json
# Capabilities released for writing, one at a time, after observing each on the
# device: BUBBLES, FILTER_PUMP, HEATER, TARGET_TEMPERATURE, CONTROL_PANEL_LOCK
HOMEFLOW_BESTWAY_WRITE_ENABLED=

# Outdoor temperature, from a public forecast service. Off by default: it is
# the one thing in HomeFlow that reaches outside the household. The coordinates
# say where someone lives, so they belong here and never in the repository.
# Use the centre of a district rather than an address; the weather is the same.
HOMEFLOW_WEATHER_ENABLED=false
HOMEFLOW_WEATHER_LATITUDE=52.5200
HOMEFLOW_WEATHER_LONGITUDE=13.4050
HOMEFLOW_WEATHER_DISPLAY_NAME=Aussentemperatur
HOMEFLOW_WEATHER_POLL_SECONDS=900

# One-shot timers ("start in N hours", "run for N hours"). A timer is the only
# unattended physical write in HomeFlow; see docs/adr/0012-one-shot-timers.md.
HOMEFLOW_SCHEDULE_MAX_HOURS=24
HOMEFLOW_SCHEDULE_TICK_SECONDS=20

# Home Assistant, the integration gateway for Hue, Sonos, tado, Miele and Ring.
# Use a dedicated non-administrator Home Assistant account, never your own.
# Setting it up: docs/runbooks/home-assistant.md
HOMEFLOW_HOME_ASSISTANT_ENABLED=false
HOMEFLOW_HOME_ASSISTANT_BASE_URL=http://home-assistant.example.internal:8123
HOMEFLOW_HOME_ASSISTANT_TOKEN=replace-me
# Entity domains released for writing, after checking each on the real devices.
# Empty means read-only, which is where every integration starts.
# Releasable: light, switch, media_player, climate
# "lock" is refused: door control needs the fresh device-owner authorisation
# described in SECURITY.md, which this deployment does not have yet.
HOMEFLOW_HOME_ASSISTANT_WRITE_ENABLED=

MIELE_CLIENT_ID=replace-me
MIELE_CLIENT_SECRET=replace-me
